# Deployment Configuration
# Copy to .env and fill in values — never commit .env

# Deployer private key
PRIVATE_KEY=your_private_key_here

# ERC-4337 EntryPoint (canonical v0.7 deployment — same on all chains)
ENTRY_POINT=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# RPC URL for target chain (examples)
# Robinhood Chain: https://rpc.mainnet.chain.robinhood.com
# Ethereum:        https://ethereum.publicnode.com
# BNB Chain:       https://bsc-dataseed.binance.org
# Base:            https://mainnet.base.org
# Arbitrum One:    https://arb1.arbitrum.io/rpc
# Polygon:         https://polygon-bor-rpc.publicnode.com
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Block explorer API key for contract verification (optional)
# Etherscan / BscScan / Basescan / Arbiscan / Polygonscan
ETHERSCAN_API_KEY=
